---
import Layout from '../layouts/Layout.astro';
---

<Layout title="LIFTSW.ACADEMY - Calendario de Clases">
  <!-- Hero Section -->
  <header class="relative min-h-screen flex flex-col items-center justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 bg-black/40 z-10"></div>
      <img
        id="hero-parallax-img"
        alt="Zona de calistenia del gimnasio URBANLIFT"
        class="w-full h-full object-cover video-mask-bottom"
        src="/img/home-calistenia.jpg"
        width="1600"
        height="1736"
        fetchpriority="high"
        style="transform: scale(1.5);"
      />
    </div>
    <div class="relative z-20 text-center px-4 max-w-5xl">
      <h1 class="font-headline font-black text-6xl md:text-9xl uppercase tracking-tighter leading-none mb-6 text-on-surface text-overlap">
        LIFT<span class="text-primary">SW</span>.ACADEMY
      </h1>
      <p class="font-headline text-xl md:text-3xl font-light uppercase tracking-widest text-on-surface-variant max-w-3xl mx-auto mb-10 border-l-4 border-primary-container pl-6 py-2">
        Domina tu cuerpo, forja tu fuerza. Clases abiertas para todos los niveles.
      </p>
      <div class="flex flex-wrap justify-center gap-6">
        <a href="https://wa.me/56932818911" target="_blank" rel="noopener noreferrer" class="kinetic-gradient text-on-primary-container font-bold px-10 py-5 rounded-xl uppercase tracking-widest text-lg shadow-2xl hover:scale-105 transition-all">
          RESERVAR MI CLASE
        </a>
        <a href="#calendario" class="border border-outline px-10 py-5 rounded-xl uppercase tracking-widest text-lg hover:bg-surface-container-high transition-all">
          VER HORARIOS
        </a>
      </div>
    </div>
  </header>

  <!-- Methodology Section -->
  <section class="bg-surface-container-lowest py-32 px-6">
    <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-16 items-center">
      <div class="relative">
        <div class="absolute -top-12 -left-12 w-64 h-64 bg-primary-container/10 blur-3xl rounded-full"></div>
        <img alt="Close up of a person's chalked hands gripping a pull up bar in a dark industrial gym setting with dramatic orange side light" class="relative z-10 rounded-lg shadow-2xl grayscale hover:grayscale-0 transition-all duration-700" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDL3pKH30-vV1KIhLGbQD_0oOJ7MfXylZs659dlYH5PWUozu-n7Y8KAlk4BPIbKO00fJx__mK1N-RUjBW5IvMD_VCca6sbrWr1cPcF2T88pazXq4jNKfs1BfCtC3YbZACyT44VA-vHwk_hFMFTbdPNEQ3AErCqe7OGBZ19Uhgq_gPbY55KRbF82OuXy3SUZjatp_CCKicR3_3IKqWcOl-gGTUPaxngx5YcU9ySHZjoezuzDnufornmsrOJTBNAA1wNpZpL_B-TXiBg"/>
      </div>
      <div class="space-y-8">
        <h2 class="font-headline text-3xl md:text-4xl font-black uppercase tracking-tighter text-on-background">
          Clases de Calistenia <br /><span class="text-primary">Liftsw Academy</span>
        </h2>
        <div class="h-1 w-24 bg-primary-container"></div>
        <p class="font-body text-xl md:text-2xl text-on-surface-variant leading-relaxed font-light">
        En Liftsw Academy creemos que la calistenia es mucho más que entrenar. Queremos ayudarte a descubrir de lo que eres capaz, llevando tu fuerza, técnica y confianza al siguiente nivel. Nuestras clases son para todos: si estás empezando, te enseñaremos desde lo más básico; si ya tienes experiencia, te ayudaremos a dominar habilidades y movimientos más avanzados.
        </p>
        <p class="font-body text-xl md:text-2xl text-on-surface-variant leading-relaxed font-light">
        Entrenamos en grupos multinivel y con cupos limitados para que recibas una atención cercana y puedas avanzar a tu propio ritmo. Además, contamos con un espacio diseñado especialmente para la calistenia, equipado con implementos de alta calidad para que disfrutes cada entrenamiento y saques lo mejor de ti.
        </p>

        </p>
        <div class="grid grid-cols-2 gap-8 pt-8">
          <div class="space-y-2">
            <span class="material-symbols-outlined text-primary text-4xl">fitness_center</span>
            <h4 class="font-headline font-bold uppercase tracking-widest">Street Lifting</h4>
            <p class="text-sm text-on-secondary-container">Fuerza pura con lastre.</p>
          </div>
          <div class="space-y-2">
            <span class="material-symbols-outlined text-primary text-4xl">sports_gymnastics</span>
            <h4 class="font-headline font-bold uppercase tracking-widest">Skills</h4>
            <p class="text-sm text-on-secondary-container">Control corporal total.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Training Plans (mismo patrón que "Horarios de Apertura" en el home) -->
  <section class="py-24 px-6">
    <div class="w-full max-w-7xl mx-auto bg-surface-container-low p-10 md:p-16 relative overflow-hidden group">
      <div class="relative z-10 max-w-4xl mx-auto">
        <h3 class="font-headline text-4xl md:text-5xl font-bold uppercase mb-12 text-center">Planes de entrenamiento</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 font-body">
          <!-- Plan 1 -->
          <div class="flex flex-col items-center md:items-start text-center md:text-left">
            <span class="text-on-surface/60 uppercase text-base tracking-widest mb-4">4 clases</span>
            <div class="text-2xl font-headline font-bold text-on-background">$30.000</div>
            <div class="w-12 h-1 bg-primary-container mt-6"></div>
          </div>
          <!-- Plan 2 -->
          <div class="flex flex-col items-center md:items-start text-center md:text-left">
            <span class="text-on-surface/60 uppercase text-base tracking-widest mb-4">8 clases</span>
            <div class="text-2xl font-headline font-bold text-on-background">$50.000</div>
            <div class="w-12 h-1 bg-primary-container mt-6"></div>
          </div>
          <!-- Plan 3 -->
          <div class="flex flex-col items-center md:items-start text-center md:text-left">
            <span class="text-on-surface/60 uppercase text-base tracking-widest mb-4">12 clases</span>
            <div class="text-2xl font-headline font-bold text-on-background">$65.000</div>
            <div class="w-12 h-1 bg-primary-container mt-6"></div>
          </div>
        </div>
      </div>
      <span class="material-symbols-outlined absolute -bottom-12 -right-12 text-surface-container-high text-9xl opacity-10 pointer-events-none" style="font-size: 20rem;">payments</span>
    </div>
  </section>

  <!-- Schedules Section -->
  <section class="bg-surface py-32 px-6 relative overflow-hidden" id="calendario">
    <div class="max-w-7xl mx-auto">
      <div class="mb-20 flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <h2 class="font-headline text-5xl md:text-7xl font-extrabold uppercase leading-none tracking-tighter mb-4">Calendario <span class="text-primary">Semanal</span></h2>
        </div>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <!-- Tuesday -->
        <div class="bg-surface-container-high p-8 group hover:bg-primary-container transition-all duration-500 border-l-4 border-primary-container">
          <h3 class="font-headline font-bold text-2xl uppercase mb-8 group-hover:text-on-primary-container">MARTES</h3>
          <div class="space-y-4">
            <div class="flex flex-col">
              <span class="text-3xl font-black font-headline group-hover:text-on-primary-container">19:00 a 20:30</span>
              <span class="text-primary font-bold uppercase tracking-widest text-xs group-hover:text-on-primary-container">HRS</span>
            </div>
            <div class="pt-4 border-t border-outline-variant group-hover:border-on-primary-container/20">
              <span class="font-headline font-bold group-hover:text-on-primary-container">COACHES:</span>
              <p class="font-body group-hover:text-on-primary-container">THOMAS &amp; ALLISON</p>
            </div>
          </div>
        </div>
        <!-- Thursday -->
        <div class="bg-surface-container-high p-8 group hover:bg-primary-container transition-all duration-500 border-l-4 border-primary-container">
          <h3 class="font-headline font-bold text-2xl uppercase mb-8 group-hover:text-on-primary-container">JUEVES</h3>
          <div class="space-y-4">
            <div class="flex flex-col">
              <span class="text-3xl font-black font-headline group-hover:text-on-primary-container">19:00 a 20:30</span>
              <span class="text-primary font-bold uppercase tracking-widest text-xs group-hover:text-on-primary-container">HRS</span>
            </div>
            <div class="pt-4 border-t border-outline-variant group-hover:border-on-primary-container/20">
              <span class="font-headline font-bold group-hover:text-on-primary-container">COACHES:</span>
              <p class="font-body group-hover:text-on-primary-container">THOMAS &amp; ALLISON</p>
            </div>
          </div>
        </div>
        <!-- Saturday -->
        <div class="bg-surface-container-high p-8 group hover:bg-primary-container transition-all duration-500 border-l-4 border-primary-container">
          <h3 class="font-headline font-bold text-2xl uppercase mb-8 group-hover:text-on-primary-container">SÁBADO</h3>
          <div class="space-y-4">
            <div class="flex flex-col">
              <span class="text-3xl font-black font-headline group-hover:text-on-primary-container">10:00 a 11:30</span>
              <span class="text-primary font-bold uppercase tracking-widest text-xs group-hover:text-on-primary-container">HRS</span>
            </div>
            <div class="pt-4 border-t border-outline-variant group-hover:border-on-primary-container/20">
              <span class="font-headline font-bold group-hover:text-on-primary-container">COACHES:</span>
              <p class="font-body group-hover:text-on-primary-container">THOMAS &amp; ALLISON</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Visual Divider / CTA -->
  <section class="h-[512px] relative flex items-center justify-center">
    <div class="absolute inset-0 z-0">
      <img alt="A muscular athlete doing a human flag on a vertical bar, highly detailed silhouette against a dark industrial background with orange rim lighting" class="w-full h-full object-cover opacity-60" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDIB3Y3_9BTBOp0zZ9cwtRree0EchwBi85aFhOllW0rEvPbRFy3QUWh0Ce2nXAlaTMdrGp7QJ10i2YsC3ERWHp2GK31y7zPTF-2uJPnM6KKB9G7E5ADjsVR7nYOCADQWAnlL52y7aqxenbIoIFtBdWGcTh5nJPQ5GQJPjxwEGL7csbmSW7DmtJAB2ceuV_OypiOGTy_GOMiQ2Rty0FC-7RSCmGjZofhAFiyfvVONEJF1JcD8iDUKt-zCmgVXIcdwVmQ5z_M__1Z86U"/>
      <div class="absolute inset-0 bg-black/40"></div>
    </div>
    <div class="relative z-10 text-center max-w-4xl px-6">
      <h2 class="font-headline text-4xl md:text-6xl font-black uppercase tracking-tighter mb-8 leading-tight">
        ¿LISTO PARA EL SIGUIENTE NIVEL?
      </h2>
      <a href="https://wa.me/56932818911" target="_blank" rel="noopener noreferrer" class="inline-block kinetic-gradient text-on-primary-container font-extrabold px-12 py-6 rounded-xl uppercase tracking-widest text-xl shadow-2xl transform hover:scale-110 transition-all">
        RESERVAR MI CLASE
      </a>
    </div>
  </section>
</Layout>

<script>
  // Parallax de la foto del hero. Mismo cálculo que en index.astro: el tope y
  // la velocidad se derivan del margen que deja el scale, para que el recorrido
  // se agote justo cuando el hero sale de pantalla y el clamp no se note.
  const HERO_SCALE = 1.5;
  const heroParallaxImg = document.getElementById('hero-parallax-img');
  if (heroParallaxImg) {
    let maxOffset = 0;
    let speed = 0;

    const measure = () => {
      const heroHeight = heroParallaxImg.parentElement?.offsetHeight || window.innerHeight;
      maxOffset = (heroHeight * (HERO_SCALE - 1)) / 2;
      speed = maxOffset / heroHeight;
    };

    const updateParallax = () => {
      const offset = Math.min(maxOffset, window.scrollY * speed);
      heroParallaxImg.style.transform = `scale(${HERO_SCALE}) translateY(${offset}px)`;
    };

    measure();
    updateParallax();
    window.addEventListener('scroll', updateParallax, { passive: true });
    window.addEventListener('resize', () => {
      measure();
      updateParallax();
    });
  }
</script>
