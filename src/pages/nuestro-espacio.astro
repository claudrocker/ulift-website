---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';

// Galería dinámica: lee todas las fotos de public/img/zonas en build time.
// Agregar/quitar un archivo en esa carpeta actualiza la galería sin tocar código.
const zonasDir = path.join(process.cwd(), 'public/img/zonas');
const zonaFiles = fs
  .readdirSync(zonasDir)
  .filter((file) => /\.(jpe?g|png|webp)$/i.test(file))
  .sort();

// Orden y títulos de la galería: un solo array define ambas cosas. `label`
// es opcional — si se omite, se usa el título automático derivado del
// nombre de archivo (ver `toLabel`). El nombre de archivo es la clave, tal
// como se escribe en el código (NFC); ver nota de normalización más abajo.
const ZONA_ORDER: { file: string; label?: string }[] = [
  { file: 'calistenia.jpg', label: 'Zona de Calistenia y Street Lifting' },
  { file: 'calistenia-2.jpg', label: 'Zona de Calistenia y Street Lifting' },
  { file: 'calistenia-3.jpg', label: 'Zona de Calistenia y Street Lifting' },
  { file: 'peso-libre.jpg', label: 'Zona de Peso Libre' },
  { file: 'peso-libre-2.jpg', label: 'Zona de Peso Libre' },
  { file: 'cardio.jpg', label: 'Zona de Cardio' },
  { file: 'selfies-camarines.jpg', label: 'Zona de Selfies' },
  { file: 'baños.jpg', label: 'Baños' },
  { file: 'duchas.jpg', label:'Duchas' },
  { file: 'camarines.jpg', label: 'Camarines' },
  
];

// Nota: macOS guarda nombres de archivo con tildes en NFD (ej. "ñ" como
// "n" + tilde combinada), pero el código fuente los escribe en NFC ("ñ"
// como un solo carácter) — son bytes distintos aunque se vean igual. Sin
// normalizar, ni el match contra ZONA_ORDER ni un `\b\w` regex funcionan
// bien con acentos, así que se normaliza antes de ambas cosas.
const toLabel = (filename: string) => {
  const base = filename.replace(/\.[^.]+$/, '').replace(/-\d+$/, '');
  return base
    .split('-')
    .filter(Boolean)
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
};

// Mapa nombre-normalizado → nombre real en disco, para poder ordenar por
// ZONA_ORDER y a la vez servir la foto con el nombre de archivo real.
const zonaFilesByKey = new Map(zonaFiles.map((file) => [file.normalize('NFC'), file]));
const orderedKeys = new Set(ZONA_ORDER.map((z) => z.file));

const zonaImages = [
  // 1. Fotos listadas en ZONA_ORDER, en ese orden (se saltan si el archivo ya no existe).
  ...ZONA_ORDER.filter((z) => zonaFilesByKey.has(z.file)).map((z) => ({
    src: `/img/zonas/${zonaFilesByKey.get(z.file)}`,
    alt: z.label ?? toLabel(z.file),
  })),
  // 2. Fotos nuevas que aún no están en ZONA_ORDER: aparecen al final, en orden alfabético.
  ...zonaFiles
    .filter((file) => !orderedKeys.has(file.normalize('NFC')))
    .map((file) => {
      const key = file.normalize('NFC');
      return { src: `/img/zonas/${file}`, alt: toLabel(key) };
    }),
];
---

<Layout title="Nuestro Espacio - URBANLIFT">
  <main>
    <!-- Hero Section -->
    <section class="relative h-[614px] flex items-end px-8 pb-16 overflow-hidden">
      <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 bg-black/40 z-10"></div>
        <!-- Mismo tratamiento que el hero del home: filtro grayscale, máscara
             que desvanece el pie de la foto y parallax al hacer scroll. -->
        <img
          id="hero-parallax-img"
          alt="Interior del gimnasio URBANLIFT"
          class="w-full h-full object-cover [mask-image:linear-gradient(to_bottom,black_80%,transparent_95%)]"
          src="/img/nuestro-espacio.jpg"
          width="1600"
          height="1200"
          fetchpriority="high"
          style="transform: scale(1.5);"
        />
      </div>
      <div class="relative z-10 max-w-4xl">
        <h1 class="font-headline text-6xl md:text-8xl font-bold uppercase tracking-tighter leading-[0.85] text-on-background">
          NUESTRO <br/> <span class="text-primary italic">ESPACIO</span>
        </h1>
        <p class="mt-6 text-xl text-on-surface-variant max-w-xl font-light">
          Conoce nuestras instalaciones pensadas y diseñadas para ti. Entrena con el equipo de más alta calidad
        </p>
      </div>
    </section>

    <!-- Masonry Gallery: fotos de public/img/zonas, click para ampliar con navegación prev/next -->
    <section class="px-8 py-24 bg-surface-container-lowest">
      <div class="max-w-7xl mx-auto">
        <div class="flex items-center justify-between mb-8 border-b border-outline-variant/20 pb-4">
          <h2 class="font-headline text-5xl md:text-5xl font-extrabold uppercase leading-none tracking-tighter mb-4">Zonas en <span class="text-primary">Urbanlift</span></h2>
        </div>
        <div id="zonas-masonry" class="relative">
          <div class="masonry-sizer w-full sm:w-1/2 lg:w-1/3"></div>
          {zonaImages.map((img, index) => (
            <div class="masonry-item w-full sm:w-1/2 lg:w-1/3 p-3">
              <button
                type="button"
                class="group relative block w-full overflow-hidden bg-surface-container-high cursor-zoom-in outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-surface-container-lowest"
                data-gallery-trigger
                data-gallery-index={index}
                aria-label={`Ampliar foto: ${img.alt}`}
              >
                <img
                  src={img.src}
                  alt={img.alt}
                  loading="lazy"
                  class="w-full h-auto object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest/80 via-transparent to-transparent"></div>
                <div class="absolute bottom-0 left-0 p-6">
                  <h3 class="font-headline text-lg font-bold uppercase tracking-tight text-on-background opacity-0 group-hover:opacity-100 transition-opacity">{img.alt}</h3>
                </div>
              </button>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Lightbox de la galería -->
    <div id="zona-lightbox" class="fixed inset-0 z-[100] hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-label="Foto ampliada">
      <div class="absolute inset-0 bg-black/90 backdrop-blur-sm" data-zona-lightbox-backdrop></div>

      <button
        class="absolute top-6 right-6 z-20 text-white/60 hover:text-primary transition-colors"
        data-zona-lightbox-close
        aria-label="Cerrar"
      >
        <span class="material-symbols-outlined text-4xl">close</span>
      </button>

      <button
        class="absolute left-2 md:left-8 top-1/2 -translate-y-1/2 z-20 text-white/60 hover:text-primary transition-colors"
        data-zona-lightbox-prev
        aria-label="Foto anterior"
      >
        <span class="material-symbols-outlined text-5xl">chevron_left</span>
      </button>

      <button
        class="absolute right-2 md:right-8 top-1/2 -translate-y-1/2 z-20 text-white/60 hover:text-primary transition-colors"
        data-zona-lightbox-next
        aria-label="Foto siguiente"
      >
        <span class="material-symbols-outlined text-5xl">chevron_right</span>
      </button>

      <div class="relative z-10 max-w-5xl max-h-[85vh] w-full flex flex-col items-center gap-4">
        <img id="zona-lightbox-img" src="" alt="" class="max-w-full max-h-[75vh] object-contain" />
        <p id="zona-lightbox-caption" class="text-on-background font-headline uppercase tracking-widest text-sm"></p>
      </div>
    </div>
  </main>
</Layout>

<script>
  // Parallax de la foto del hero. Mismo cálculo que en index.astro y
  // calistenia.astro: el tope y la velocidad se derivan del margen que deja el
  // scale, para que el recorrido se agote justo cuando el hero sale de pantalla
  // y el clamp no se note. Debe coincidir con el `transform` inline del <img>.
  //
  // Junto con el parallax, la foto se desenfoca suavemente a medida que se
  // hace scroll a lo largo del hero (mismo `progress` 0→1 que agota el
  // recorrido del parallax), reforzando la transición hacia el resto del
  // sitio.
  const HERO_SCALE = 1.5;
  const BLUR_MAX = 8;
  const heroParallaxImg = document.getElementById('hero-parallax-img');
  if (heroParallaxImg) {
    let maxOffset = 0;
    let speed = 0;
    let heroHeight = 0;

    const measure = () => {
      heroHeight = heroParallaxImg.parentElement?.offsetHeight || window.innerHeight;
      maxOffset = (heroHeight * (HERO_SCALE - 1)) / 2;
      speed = maxOffset / heroHeight;
    };

    const updateParallax = () => {
      const offset = Math.min(maxOffset, window.scrollY * speed);
      const progress = heroHeight ? Math.min(1, window.scrollY / heroHeight) : 0;
      const blurAmount = BLUR_MAX * progress;
      heroParallaxImg.style.transform = `scale(${HERO_SCALE}) translateY(${offset}px)`;
      heroParallaxImg.style.filter = `blur(${blurAmount}px)`;
    };

    measure();
    updateParallax();
    window.addEventListener('scroll', updateParallax, { passive: true });
    window.addEventListener('resize', () => {
      measure();
      updateParallax();
    });
  }
</script>

<script>
  import Masonry from 'masonry-layout';
  import imagesLoaded from 'imagesloaded';

  // Grid tipo muro de fotos (Pinterest-style). imagesLoaded relayoutea a
  // medida que cada foto termina de cargar, porque Masonry calcula alturas
  // apenas se inicializa y las fotos aún no tienen su tamaño real.
  const grid = document.getElementById('zonas-masonry');
  if (grid) {
    // Sin `gutter` numérico: con percentPosition el gutter en px se suma
    // aparte del ancho porcentual de cada columna y puede hacer que sobre
    // ancho y Masonry descarte una columna. El espaciado va por padding
    // en `.masonry-item` en su lugar.
    const masonry = new Masonry(grid, {
      itemSelector: '.masonry-item',
      columnWidth: '.masonry-sizer',
      percentPosition: true,
    });

    imagesLoaded(grid).on('progress', () => {
      masonry.layout();
    });
  }

  // Lightbox: click en una foto la abre ampliada, con flechas y teclado
  // (← → para navegar, Escape para cerrar), igual que los modales del sitio.
  const triggers = Array.from(document.querySelectorAll<HTMLElement>('[data-gallery-trigger]'));
  const lightbox = document.getElementById('zona-lightbox');
  const lightboxImg = document.getElementById('zona-lightbox-img') as HTMLImageElement | null;
  const lightboxCaption = document.getElementById('zona-lightbox-caption');
  let currentIndex = 0;

  function showImage(index: number) {
    if (!lightboxImg || triggers.length === 0) return;
    currentIndex = (index + triggers.length) % triggers.length;
    const img = triggers[currentIndex].querySelector('img');
    if (!img) return;
    lightboxImg.src = img.src;
    lightboxImg.alt = img.alt;
    if (lightboxCaption) lightboxCaption.textContent = img.alt;
  }

  function openLightbox(index: number) {
    if (!lightbox) return;
    showImage(index);
    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
    document.body.style.overflow = '';
  }

  triggers.forEach((trigger, index) => {
    trigger.addEventListener('click', () => openLightbox(index));
  });

  document.querySelector('[data-zona-lightbox-close]')?.addEventListener('click', closeLightbox);
  document.querySelector('[data-zona-lightbox-backdrop]')?.addEventListener('click', closeLightbox);
  document.querySelector('[data-zona-lightbox-prev]')?.addEventListener('click', () => showImage(currentIndex - 1));
  document.querySelector('[data-zona-lightbox-next]')?.addEventListener('click', () => showImage(currentIndex + 1));

  document.addEventListener('keydown', (e) => {
    if (!lightbox || lightbox.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') showImage(currentIndex - 1);
    if (e.key === 'ArrowRight') showImage(currentIndex + 1);
  });
</script>
